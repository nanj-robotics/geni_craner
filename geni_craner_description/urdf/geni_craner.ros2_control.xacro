<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="geni_craner_ros2_control" params="prefix">

    <ros2_control name="GeniCranerHardware" type="system">
      <hardware>
        <plugin>geni_craner_hardware/RsA3HardwareInterface</plugin>
        <param name="host_can_id">0xFD</param>
        <param name="position_kp">100.0</param>
        <param name="position_kd">4.0</param>
        <param name="velocity_limit">0.2</param>
        <param name="max_velocity">0.2</param>
        <param name="max_acceleration">0.5</param>
        <param name="smoothing_alpha">0.8</param>
        <param name="use_mock_hardware">false</param>
      </hardware>

      <joint name="${prefix}joint1">
        <param name="motor_id">1</param>
        <param name="motor_type">RS06</param>
        <param name="can_interface">can1</param>
        <param name="direction">-1.0</param>
        <param name="lower_limit">-3.1415</param>
        <param name="upper_limit">3.1415</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint2">
        <param name="motor_id">2</param>
        <param name="motor_type">RS03</param>
        <param name="can_interface">can1</param>
        <param name="direction">-1.0</param>
        <param name="lower_limit">-2.0944</param>
        <param name="upper_limit">2.0944</param>
        <param name="kp">200</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint3">
        <param name="motor_id">3</param>
        <param name="motor_type">RS00</param>
        <param name="can_interface">can0</param>
        <param name="direction">-1.0</param>
        <param name="lower_limit">-3.1415</param>
        <param name="upper_limit">3.1415</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint4">
        <param name="motor_id">4</param>
        <param name="motor_type">RS00</param>
        <param name="can_interface">can0</param>
        <param name="direction">-1.0</param>
        <param name="lower_limit">-1.658</param>
        <param name="upper_limit">1.658</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint5">
        <param name="motor_id">5</param>
        <param name="motor_type">RS00</param>
        <param name="can_interface">can0</param>
        <param name="direction">-1.0</param>
        <param name="lower_limit">-3.1415</param>
        <param name="upper_limit">3.1415</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint6">
        <param name="motor_id">6</param>
        <param name="motor_type">RS00</param>
        <param name="can_interface">can0</param>
        <param name="direction">-1.0</param>
        <param name="lower_limit">-1.658</param>
        <param name="upper_limit">1.658</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint7">
        <param name="motor_id">7</param>
        <param name="motor_type">RS00</param>
        <param name="can_interface">can0</param>
        <param name="direction">-1.0</param>
        <param name="lower_limit">-3.1415</param>
        <param name="upper_limit">3.1415</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

    </ros2_control>

  </xacro:macro>
</robot>
